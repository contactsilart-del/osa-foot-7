/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# Le CSS et le JS ne portent pas d'empreinte dans leur nom : une durée de vie
# longue retarderait d'autant l'arrivée d'un correctif chez les visiteurs déjà
# venus. 10 minutes de fraîcheur, puis revalidation en arrière-plan.
# Les modules ES doivent rester coherents entre eux et avec les Functions.
# `stale-while-revalidate` servait pendant 24 h un melange de versions : un
# panel d'administration pouvait tourner sur l'ancien code apres une mise a
# jour, meme apres Ctrl+F5 — la reponse perimee etant rendue immediatement.
#
# Cloudflare Pages impose un plancher de 4 h sur les assets : `max-age` plus
# court est ignore, seules les directives supplementaires passent. On garde
# donc `must-revalidate`, qui interdit d'utiliser une reponse perimee sans
# demander. Un rechargement force ramene desormais toujours la derniere
# version, et le serveur ne depend plus de la fraicheur du panel : un document
# incomplet est complete, jamais refuse (voir functions/api/content.js).
/assets/*
  Cache-Control: public, max-age=14400, must-revalidate

/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
