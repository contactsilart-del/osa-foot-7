/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# Le CSS et le JS ne portent pas d'empreinte dans leur nom : une durée de vie
# longue retarderait d'autant l'arrivée d'un correctif chez les visiteurs déjà
# venus. 10 minutes de fraîcheur, puis revalidation en arrière-plan.
# Les modules ES doivent rester coherents entre eux et avec les Functions.
# Sans empreinte dans les noms de fichiers, `stale-while-revalidate` servait
# pendant 24 h un melange de versions : un panel d'administration pouvait
# tourner sur l'ancien code apres une mise a jour, meme apres Ctrl+F5.
# On revalide donc a chaque chargement — un 304 coute presque rien.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
