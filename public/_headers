/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# Le CSS et le JS ne portent pas d'empreinte dans leur nom : toute duree de vie
# non nulle repousse d'autant l'arrivee d'un correctif chez un visiteur deja
# venu — et il n'y a aucun moyen de le rattraper entre-temps.
#
# `max-age=0, must-revalidate` : le navigateur redemande a chaque fois, et le
# serveur repond « 304, rien de neuf » tant que le fichier n'a pas bouge. Le
# cout est celui d'un aller-retour de quelques centaines d'octets par fichier ;
# le gain, une mise en ligne visible immediatement, sans demander a personne de
# vider son cache.
#
# `stale-while-revalidate` est banni ici : il rendait la reponse perimee
# *immediatement*, donc un panel d'administration pouvait tourner sur l'ancien
# code apres une mise a jour, meme apres Ctrl+F5. Pire, il fige aussi les
# en-tetes — un objet garde en cache continue d'annoncer l'ancienne politique,
# ce qui donne l'illusion que la nouvelle n'est pas appliquee.
/assets/*
  Cache-Control: no-cache

# Sonde temporaire : le plancher de 4 h tient-il au chemin /assets/ ou au type
# de fichier ? Meme extension, autre dossier, duree de vie courte.
/sonde/*
  Cache-Control: public, max-age=60

/img/*
  Cache-Control: public, max-age=604800, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
